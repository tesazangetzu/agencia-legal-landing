---
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { processSteps } from "@/data/process";

const numbers = processSteps.map((_, index) =>
  String(index + 1).padStart(2, "0"),
);
---

<section id="proceso" class="bg-sand py-16 lg:py-[6.5rem]">
  <Container>
    <SectionHeading
      eyebrow="Cómo trabajamos"
      title="Un proceso claro, de la primera conversación al seguimiento."
      description="Sin promesas de resultado. Definimos el alcance, los riesgos y el siguiente paso antes de avanzar."
    />

    <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-8">
      {
        processSteps.map((step, index) => (
          <li class="border-t border-line pt-6">
            <p
              class="font-display text-display-md font-semibold text-brass-deep"
              aria-hidden="true"
            >
              {numbers[index]}
            </p>
            <h3 class="mt-4 font-display text-2xl font-semibold text-ink">
              {step.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-graphite">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
