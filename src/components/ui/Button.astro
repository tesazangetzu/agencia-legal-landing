---
import { cn } from "@/lib/cn";

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "accent";
  type?: "button" | "submit";
  class?: string;
  ariaDescribedby?: string;
}

const {
  href,
  variant = "primary",
  type = "button",
  class: className,
  ariaDescribedby,
} = Astro.props;

const base =
  "inline-flex min-h-11 items-center justify-center gap-2 rounded-sm px-5 py-2.5 text-sm font-medium transition-colors duration-150 motion-reduce:transition-none sm:px-6";

const variants = {
  primary:
    "border border-ink bg-ink text-ivory hover:border-graphite hover:bg-graphite",
  secondary:
    "border border-line bg-transparent text-ink hover:border-brass-deep hover:text-brass-deep",
  accent:
    "border border-brass bg-brass text-ink hover:border-brass-light hover:bg-brass-light",
};

const classes = cn(base, variants[variant], className);
---

{
  href ? (
    <a href={href} class={classes} aria-describedby={ariaDescribedby}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-describedby={ariaDescribedby}>
      <slot />
    </button>
  )
}
