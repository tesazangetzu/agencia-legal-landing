---
import { cn } from "@/lib/cn";

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  class?: string;
}

const { eyebrow, title, description, class: className } = Astro.props;
---

<div class={cn("max-w-[62ch]", className)}>
  <p class="flex items-center gap-3 text-xs font-medium uppercase tracking-[0.18em] text-brass-deep">
    <span class="h-px w-8 bg-brass" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h2 class="mt-5 font-display text-display-lg text-ink">{title}</h2>
  {
    description && (
      <p class="mt-5 max-w-[60ch] text-body-lg text-graphite">{description}</p>
    )
  }
</div>
