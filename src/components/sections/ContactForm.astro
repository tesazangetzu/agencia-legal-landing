---
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import { services } from "@/data/services";

const labelClass = "block text-sm font-medium text-ink";
const requiredMark = "font-normal text-muted";
const fieldClass =
  "min-h-11 w-full rounded-sm border border-line bg-white px-3 py-2.5 text-body text-ink placeholder:text-muted transition-colors duration-150 focus:border-brass-deep motion-reduce:transition-none";
---

<section id="contacto" class="bg-ivory py-16 lg:py-[6.5rem]">
  <Container>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="Contacto"
          title="Cuéntanos qué necesitas."
          description="Completa los datos para preparar la primera conversación. Si prefieres otro canal, encontrarás teléfono, correo y WhatsApp más abajo."
        />
        <div class="mt-10 hidden border-t border-line pt-6 lg:block">
          <p class="max-w-[36ch] text-sm leading-relaxed text-muted">
            Revisamos cada solicitud de forma individual. La información que
            compartas se trata con reserva profesional.
          </p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <Card>
          <p
            id="form-demo-note"
            class="border-l-2 border-brass bg-sand px-4 py-3 text-sm text-graphite"
          >
            <strong class="font-semibold text-ink"
              >Formulario de demostración.</strong
            >{" "}En esta versión no se envían datos.
          </p>

          <form
            class="mt-6 grid gap-5 sm:grid-cols-2"
            novalidate
            onsubmit="return false"
          >
            <div>
              <label for="nombre" class={labelClass}>
                Nombre <span class={requiredMark}>(obligatorio)</span>
              </label>
              <input
                id="nombre"
                name="nombre"
                type="text"
                autocomplete="name"
                required
                class:list={[fieldClass, "mt-2"]}
              />
            </div>

            <div>
              <label for="email" class={labelClass}>
                Correo electrónico <span class={requiredMark}>(obligatorio)</span>
              </label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class:list={[fieldClass, "mt-2"]}
              />
            </div>

            <div>
              <label for="telefono" class={labelClass}>
                Teléfono <span class={requiredMark}>(opcional)</span>
              </label>
              <input
                id="telefono"
                name="telefono"
                type="tel"
                autocomplete="tel"
                class:list={[fieldClass, "mt-2"]}
              />
            </div>

            <div>
              <label for="area" class={labelClass}>
                Área de interés <span class={requiredMark}>(obligatorio)</span>
              </label>
              <select
                id="area"
                name="area"
                required
                class:list={[fieldClass, "mt-2 appearance-none"]}
              >
                <option value="" disabled selected>Selecciona un área</option>
                {services.map((service) => (
                  <option value={service.title}>{service.title}</option>
                ))}
              </select>
            </div>

            <div class="sm:col-span-2">
              <label for="mensaje" class={labelClass}>
                Mensaje <span class={requiredMark}>(obligatorio)</span>
              </label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                required
                class:list={[fieldClass, "mt-2 resize-y"]}
              ></textarea>
            </div>

            <div class="flex items-start gap-3 sm:col-span-2">
              <input
                id="privacidad"
                name="privacidad"
                type="checkbox"
                required
                class="mt-1 h-4 w-4 shrink-0 rounded-sm border border-line accent-ink"
              />
              <div class="text-sm text-graphite">
                <label for="privacidad" class="font-medium text-ink">
                  Acepto la política de privacidad{" "}
                  <span class={requiredMark}>(obligatorio)</span>.
                </label>
                <a
                  href="/privacidad"
                  class="ml-1 text-brass-deep underline underline-offset-4 hover:text-ink"
                  >Leer la política</a
                >
              </div>
            </div>

            <div class="sm:col-span-2">
              <Button type="button" ariaDescribedby="form-demo-note">
                Enviar solicitud
              </Button>
              <p class="mt-3 text-xs text-muted">
                El botón no realiza ninguna petición de red.
              </p>
            </div>
          </form>
        </Card>
      </div>
    </div>
  </Container>
</section>
