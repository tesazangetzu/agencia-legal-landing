---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { navigation, site } from "@/data/site";

const base = Astro.url.pathname === "/" ? "" : "/";
const navHref = (href: string) => (href.startsWith("#") ? `${base}${href}` : href);
---

<header class="sticky top-0 z-50 border-b border-line bg-ivory/95 backdrop-blur">
  <Container>
    <div class="flex h-20 items-center justify-between gap-6">
      <a href={navHref("#inicio")} class="group inline-flex items-baseline gap-3">
        <span
          class="font-display text-2xl font-semibold uppercase tracking-[0.08em] text-ink"
          >{site.name}</span
        >
        <span
          class="hidden text-[0.625rem] uppercase tracking-[0.2em] text-muted sm:inline"
          >Abogados</span
        >
      </a>

      <nav aria-label="Navegación principal" class="hidden lg:block">
        <ul class="flex items-center gap-8">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={navHref(item.href)}
                  class="text-sm text-graphite transition-colors duration-150 hover:text-brass-deep motion-reduce:transition-none"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="hidden lg:block">
        <Button href={navHref("#contacto")}>Agendar consulta</Button>
      </div>

      <details class="group relative lg:hidden" data-mobile-menu>
        <summary
          class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-sm border border-line px-4 text-sm text-ink transition-colors duration-150 hover:border-brass-deep motion-reduce:transition-none [&::-webkit-details-marker]:hidden"
          aria-expanded="false"
        >
          Menú
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
            class="transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>

        <div
          class="absolute right-0 mt-3 w-72 rounded-sm border border-line bg-ivory p-5 shadow-lift"
        >
          <nav aria-label="Navegación móvil">
            <ul class="space-y-1">
              {
                navigation.map((item) => (
                  <li>
                    <a
                      href={navHref(item.href)}
                      class="flex min-h-11 items-center rounded-sm px-3 text-sm text-graphite transition-colors duration-150 hover:bg-sand hover:text-ink motion-reduce:transition-none"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="mt-4 border-t border-line pt-4">
            <Button href={navHref("#contacto")} class="w-full">Agendar consulta</Button>
          </div>
        </div>
      </details>
    </div>
  </Container>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
  if (menu) {
    const summary = menu.querySelector("summary");
    const sync = () =>
      summary?.setAttribute("aria-expanded", String(menu.open));
    sync();
    menu.addEventListener("toggle", sync);
    menu.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => {
        menu.open = false;
      }),
    );
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) {
        menu.open = false;
      }
    });
  }
</script>
