---
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Badge from "@/components/ui/Badge.astro";
import { team } from "@/data/team";
---

<section id="equipo" class="bg-ivory py-16 lg:py-[6.5rem]">
  <Container>
    <SectionHeading
      eyebrow="Equipo"
      title="Abogados que explican antes de actuar."
      description="Un equipo pequeño, con especialidades definidas y una misma forma de trabajar: claridad sobre el escenario y decisiones informadas."
    />

    <div class="mt-8">
      <Badge variant="outline">
        Perfiles de ejemplo. Pendientes de validación por el despacho.
      </Badge>
    </div>

    <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {
        team.map((member) => (
          <li>
            <figure>
              <img
                src={member.image}
                width="640"
                height="800"
                alt={member.imageAlt}
                loading="lazy"
                decoding="async"
                class="aspect-[4/5] w-full rounded-sm border border-line object-cover"
              />
              <figcaption class="mt-5">
                <span class="block h-px w-8 bg-brass" aria-hidden="true" />
                <h3 class="mt-4 font-display text-2xl font-semibold text-ink">
                  {member.name}
                </h3>
                <p class="mt-1 text-sm font-medium text-ink">{member.role}</p>
                <p class="mt-1 text-sm text-muted">{member.specialty}</p>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
