---
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Card from "@/components/ui/Card.astro";
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/data/site";

const linkClass =
  "text-sm text-brass-deep underline underline-offset-4 transition-colors duration-150 hover:text-ink motion-reduce:transition-none";
---

<section id="oficina" class="bg-sand py-16 lg:py-[6.5rem]">
  <Container>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading
          eyebrow="Oficina"
          title="En San Isidro, y también en línea."
          description="Atendemos reuniones presenciales y videollamadas coordinadas previamente. Escríbenos por el canal que prefieras."
        />
      </div>

      <div class="lg:col-span-7">
        <Card>
          <div class="grid gap-8 sm:grid-cols-2">
            <div class="flex gap-4">
              <Icon name="map-pin" class="mt-0.5 h-5 w-5 shrink-0 text-brass-deep" />
              <div>
                <h3 class="text-sm font-semibold text-ink">Dirección</h3>
                <address class="mt-2 text-sm not-italic leading-relaxed text-graphite">
                  {site.address.street}<br />
                  {site.address.district}, {site.address.city}<br />
                  {site.address.country}
                </address>
                <a
                  href={site.mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[linkClass, "mt-2 inline-block"]}
                  >Ver en mapas <span class="sr-only">(se abre en una pestaña nueva)</span></a
                >
              </div>
            </div>

            <div class="flex gap-4">
              <Icon name="clock" class="mt-0.5 h-5 w-5 shrink-0 text-brass-deep" />
              <div>
                <h3 class="text-sm font-semibold text-ink">Horario</h3>
                <p class="mt-2 text-sm leading-relaxed text-graphite">
                  {site.hours}
                </p>
              </div>
            </div>

            <div class="flex gap-4">
              <Icon name="phone" class="mt-0.5 h-5 w-5 shrink-0 text-brass-deep" />
              <div>
                <h3 class="text-sm font-semibold text-ink">Teléfono</h3>
                <p class="mt-2">
                  <a href={site.phoneHref} class={linkClass}>{site.phone}</a>
                </p>
              </div>
            </div>

            <div class="flex gap-4">
              <Icon name="mail" class="mt-0.5 h-5 w-5 shrink-0 text-brass-deep" />
              <div>
                <h3 class="text-sm font-semibold text-ink">Correo</h3>
                <p class="mt-2">
                  <a href={`mailto:${site.email}`} class={linkClass}
                    >{site.email}</a
                  >
                </p>
              </div>
            </div>

            <div class="flex gap-4 sm:col-span-2">
              <Icon name="message" class="mt-0.5 h-5 w-5 shrink-0 text-brass-deep" />
              <div>
                <h3 class="text-sm font-semibold text-ink">WhatsApp</h3>
                <p class="mt-2">
                  <a
                    href={site.whatsappHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={linkClass}
                    >{site.whatsapp}
                    <span class="sr-only">(se abre en una pestaña nueva)</span></a
                  >
                </p>
              </div>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </Container>
</section>
